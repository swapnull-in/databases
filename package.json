{
  "name": "databases",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Learn database internals in TypeScript — LSM/B-tree, WAL, quorums, Dynamo-style replication, MVCC transactions.",
  "scripts": {
    "phase1": "node src/phase1/lsm.ts",
    "phase2": "node src/phase2/wal.ts",
    "phase3": "node src/phase3/btree-vs-lsm.ts",
    "phase4": "node src/phase4/quorums.ts",
    "phase5": "node src/phase5/dynamo.ts",
    "phase6": "node src/phase6/transactions.ts",
    "phase7": "node src/phase7/indexes.ts",
    "phase8": "node src/phase8/sharding.ts",
    "phase9": "node src/phase9/isolation-levels.ts",
    "phase10": "node src/phase10/buffer-pool.ts",
    "phase11": "node src/phase11/banking-ledger.ts",
    "phase12": "node src/phase12/change-data-capture.ts",
    "phase13": "node src/phase13/auction-bidding.ts",
    "web": "node web/serve.mjs",
    "deploy": "npx wrangler pages deploy web --project-name databases",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^22.10.0"
  }
}
